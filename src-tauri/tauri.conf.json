{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kastoko",
  "version": "0.6.1",
  "identifier": "com.kastoko.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:9002",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Kastoko",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Abc Develop",
    "shortDescription": "Kelola Transaksi, Cepat Lengkap",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/third-party-licenses.txt",
      "resources/indonesian-catalog.json"
    ]
  }
}