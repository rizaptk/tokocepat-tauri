# FireLite local database encryption key (ChaCha20-Poly1305).
# REQUIRED - copy to `.env` and set the same key used to encrypt existing databases.
FIRELITE_ENCRYPTION_KEY=replace-with-your-32-hex-char-key

# License JWT signing secret. MUST match the server's JWT_SECRET_KEY env var
# (see tokocepat server). Baked into release binaries at build time so packaged
# apps can verify server-issued license tokens. Required for license activation
# to succeed — if it does not match the server secret, activation returns
# INVALID_TOKEN.
VITE_JWT_SECRET=replace-with-server-JWT_SECRET_KEY